# DarkYield Environment Configuration
#
# Setup:
#   cp .env.example .env
#
# This file is the single source of truth. The backend loads `.env` from the repo
# root (whether you start it from `/` or `/backend`). Do not commit `.env`.

# =============================================================================
# NODE_ENV — development vs production
# =============================================================================
#
# development (default)
#   Use for local work. Start with:  npm run dev
#   - Frontend Vite dev server on http://localhost:3000
#   - Backend API on http://localhost:4000
#   - Vite proxies /api and /ws to the backend (see VITE_PROXY_TARGET below)
#   - Colored console logs, error stack traces in API responses
#   - CORS allows localhost:3000
#
# production
#   Use on a server or VPS. Build once, then run the compiled backend:
#     npm run build
#     NODE_ENV=production npm start
#   - Only the backend process runs (port PORT, default 4000)
#   - Helmet CSP enabled; generic 500 errors (no stack traces)
#   - Logs written to backend/logs/combined.log and backend/logs/error.log
#   - Serve frontend/dist/ behind a reverse proxy on the SAME host so /api and
#     /ws hit the backend (the UI calls relative URLs, not localhost:4000)
#
# Example nginx (same origin):
#   location / { root /path/to/darkyield/frontend/dist; try_files $uri /index.html; }
#   location /api { proxy_pass http://127.0.0.1:4000; }
#   location /ws   { proxy_pass http://127.0.0.1:4000; proxy_http_version 1.1;
#                    proxy_set_header Upgrade $http_upgrade; proxy_set_header Connection "upgrade"; }
#
# Production checklist:
#   - NODE_ENV=production
#   - LOG_LEVEL=info (or warn)
#   - PAPER_TRADING=true until live trading is fully tested
#   - TELEGRAM_BOT_TOKEN + TELEGRAM_CHAT_ID for alerts (optional)
#   - ETHERSCAN_API_KEY if using vault pause checks
#   - Private RPC URLs instead of public defaults for live trading
#   - WALLET_ADDRESS + ENCRYPTED_PRIVATE_KEY only when PAPER_TRADING=false
#
NODE_ENV=development

# Frontend dev only — ignored in production builds (Vite bakes static assets;
# the browser talks to /api on whatever host serves the UI).
# Copy to frontend/.env.development if you change backend PORT.
# VITE_PROXY_TARGET=http://127.0.0.1:4000

# Server Configuration
PORT=4000
LOG_LEVEL=info

# DefiLlama API
DEFILLAMA_API_URL=https://yields.llama.fi

# Etherscan API v2 — optional; used to flag pools whose vault contract reports paused / depositPaused
# https://etherscan.io/apis
ETHERSCAN_API_KEY=
# ETHERSCAN_PAUSE_CHECK=true
# ETHERSCAN_PAUSE_BATCH=50
# ETHERSCAN_PAUSE_DELAY_MS=80

# CoinGecko — one shared catalog refresh (≈2 HTTP calls per TTL, serialized + gap). COINGECKO_PUBLIC=false disables live calls.
# COINGECKO_API_KEY=
# COINGECKO_CATALOG_TTL_MS=21600000
# COINGECKO_HTTP_GAP_MS=4000
# COINGECKO_COINS_LIST_TTL_MS=172800000
# COINGECKO_VOLATILITY_CHART=false

# Pools: hide reported APY above this % as unreliable (DefiLlama can show absurd APY on closed vaults). Client may set a lower ceiling; hard cap caps API abuse.
# POOL_MAX_APY_PERCENT=1000
# POOL_MAX_APY_PERCENT_HARD_CAP=50000

# Pool chains: `evm_only` (default) = Solana & non-EVM networks excluded. `all` = no chain filter.
# Extend EVM list in backend/src/config/poolChains.ts when new L2s appear.
# POOL_CHAIN_FILTER_MODE=all

# Scheduler Settings
AUTO_START_SCHEDULER=true
DEFAULT_REBALANCE_FREQUENCY=DAILY
MIN_REBALANCE_INTERVAL=60
RISK_CHECK_INTERVAL=60

# Paper Trading — keep true until you intentionally switch to live on-chain execution
# (requires WALLET_ADDRESS + ENCRYPTED_PRIVATE_KEY and audited RPC endpoints)
PAPER_TRADING=true

# Trading Settings
MAX_CONCURRENT_POSITIONS=10

# Telegram Notifications (optional)
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# RPC Endpoints (optional - defaults to public Llama nodes)
ETHEREUM_RPC=https://eth.llamarpc.com
ARBITRUM_RPC=https://arb.llamarpc.com
OPTIMISM_RPC=https://opt.llamarpc.com
BASE_RPC=https://base.llamarpc.com
POLYGON_RPC=https://polygon.llamarpc.com
BSC_RPC=https://binance.llamarpc.com
AVAX_RPC=https://avax.llamarpc.com
FANTOM_RPC=https://fantom.llamarpc.com

# Wallet Configuration (only needed for live trading)
WALLET_ADDRESS=0x...
ENCRYPTED_PRIVATE_KEY=encrypted_key_here
